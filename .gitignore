# A program file built in the repo root. The ones players download are
# written to release/ by build_releases.bat.
/KnoxMap.exe

# The Electron window's dependencies and packager scratch (desktop/).
# The named downloads are copied to release/.
desktop/node_modules/
desktop/out/
desktop/pybuild/

# Local builds of the player downloads (build_releases.bat).
/release/*
!/release/.gitkeep
/releases/*
/released/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Generated packaging trees (pyinstaller, setuptools, and similar)
dist/
build/

# Generated maps, OpenStreetMap downloads and compiled lots. Large, and built
# from OSM data rather than source.
KnoxMap/output/*

# Setup installs the map tools here and writes local paths here.
/vendor/
KnoxMap/vendor/
knoxmap_config.json

# Building the patched compiler yourself
KnoxMap/worlded/src/
KnoxMap/worlded/build/

# Never commit Project Zomboid game artwork. Setup extracts it from each
# player's own install; it is The Indie Stone's and not ours to share.
Tiles/
*.pack

# Logs and leftovers
*.log
*.orig
*.bak

# Kept from the original project
.DS_Store
.claude/
CLAUDE.local.md
knoxmap_error.log

# Map tiles cached by the app, per the OSM tile policy
cache/

# A private Python that Setup.bat downloads when the PC has none
.python/
.python.zip

# Logs and problem reports (knoxlog.py)
logs/

# Downloaded updates (updater.py)
update/
.knoxmap_files.json
